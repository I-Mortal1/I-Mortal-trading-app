contract=CONDOR-STORAGE-IDENTITY-MANIFEST-V1
parent_trust_bootstrap_sha256=PUBLIC_DIGEST_REMOVED

default=DENY
fail_closed=true

purpose=DEFINE_CANONICAL_SIGNED_STORAGE_IDENTITY_MANIFEST

manifest_filename=storage-identity.manifest
manifest_location=PUBLIC_DEPLOYMENT_PATH_REMOVED
manifest_encoding=UTF8_NO_BOM
manifest_line_ending=LF
manifest_key_value_separator=EQUALS
manifest_duplicate_keys_allowed=false
manifest_unknown_keys_allowed=false
manifest_blank_lines_allowed=false
manifest_comments_allowed=false

canonical_field_order=protocol_version,storage_id,generation,parent_storage_architecture_sha256,parent_identity_protocol_sha256,signing_key_fingerprint

protocol_version_literal=CONDOR_STORAGE_IDENTITY_V1

storage_id_format=UUID_LOWERCASE
storage_id_stable_across_authorized_media_replacement=true
storage_id_generated_once_at_initial_provisioning=true

generation_format=UINT64_DECIMAL
generation_initial_value=1
generation_zero_allowed=false
generation_must_increase_on_manifest_replacement=true
generation_decrease_allowed=false
generation_reuse_allowed=false
generation_skip_policy=ALLOWED

parent_storage_architecture_sha256_required=true
parent_identity_protocol_sha256_required=true
signing_key_fingerprint_required=true

signing_key_fingerprint_algorithm=SHA256
signing_key_fingerprint_representation=LOWERCASE_HEX
signing_key_fingerprint_input=SUBJECT_PUBLIC_KEY_INFO_DER

usb_serial_is_signed_identity_field=false
usb_pnp_id_is_signed_identity_field=false
windows_disk_number_is_signed_identity_field=false
disk_unique_id_is_signed_identity_field=false
partition_number_is_signed_identity_field=false
ntfs_volume_serial_is_signed_identity_field=false
drive_letter_is_signed_identity_field=false
filesystem_size_is_signed_identity_field=false

hardware_observations_remain_supporting_evidence=true

signature_algorithm=ECDSA_P256_SHA256
signature_encoding=DER
signature_representation=BASE64

signature_field_name=signature
signature_field_last=true
signature_field_excluded_from_signed_bytes=true

signed_bytes_definition=EXACT_CANONICAL_MANIFEST_BYTES_BEFORE_SIGNATURE_FIELD
canonical_manifest_must_end_with_lf_before_signature=true

manifest_signature_required=true
manifest_signature_key_must_match_pinned_key=true

missing_required_field_allows_operation=false
duplicate_field_allows_operation=false
unknown_field_allows_operation=false
invalid_field_order_allows_operation=false
invalid_encoding_allows_operation=false
invalid_line_ending_allows_operation=false
invalid_storage_id_allows_operation=false
invalid_generation_allows_operation=false
invalid_parent_hash_allows_operation=false
invalid_key_fingerprint_allows_operation=false
invalid_signature_allows_operation=false

manifest_generation_authority_required=true
manifest_generation_authority_location=SEPARATE_TRUSTED_STATE
manifest_generation_authority_defined=false
manifest_generation_rollback_protection_required=true

manifest_replacement_requires_explicit_authorization=true
manifest_replacement_requires_generation_increment=true
manifest_replacement_requires_valid_signature=true

storage_media_replacement_requires_explicit_authorization=true
storage_media_replacement_may_preserve_storage_id=true
storage_media_replacement_requires_new_manifest_generation=true

filesystem_reformat_requires_explicit_authorization=true
filesystem_reformat_may_preserve_storage_id=true
filesystem_reformat_requires_new_manifest_generation=true

signing_key_rotation_requires_explicit_authorization=true
signing_key_rotation_requires_new_manifest_generation=true
signing_key_rotation_requires_pin_rotation=true

storage_identity_recovery_requires_explicit_authorization=true
automatic_identity_recovery_allowed=false
automatic_manifest_repair_allowed=false
automatic_manifest_regeneration_allowed=false

manifest_creation_authorized=false
manifest_replacement_authorized=false
manifest_signing_authorized=false

storage_id_generation_authorized=false
generation_authority_provisioning_authorized=false

public_key_pin_creation_authorized=false
public_key_pin_replacement_authorized=false

tpm_key_creation_authorized=false
tpm_key_rotation_authorized=false
tpm_nv_allocation_authorized=false
tpm_counter_creation_authorized=false

sqlite_installation_authorized=false
database_creation_authorized=false

provider_dispatch_enabled=false
production_authorized=false
