contract=CONDOR-REPLAY-LEDGER-V1

default=DENY
fail_closed=true

request_id_unique_required=true
nonce_unique_required=true
pair_only_uniqueness_sufficient=false

validation_before_consumption_required=true
invalid_request_consumption_allowed=false
expired_request_consumption_allowed=false

atomic_consumption_required=true
partial_consumption_allowed=false
concurrent_multiple_winners_allowed=false

restart_persistence_required=true
process_local_only_state_allowed=false
cross_process_consistency_required=true

storage_unavailable_allows_operation=false
storage_error_allows_operation=false
storage_corruption_allows_operation=false
integrity_failure_allows_operation=false

durability_before_success_required=true
acknowledge_before_durable_commit_allowed=false

rollback_detection_required=true
silent_rollback_allowed=false

request_id_case_sensitive=true
nonce_case_sensitive=true

automatic_expired_entry_deletion_allowed=false
automatic_retention_policy_enabled=false
retention_policy_version_required=true

provider_dispatch_before_replay_commit_allowed=false
hardware_operation_before_replay_commit_allowed=false
authorization_mutation_before_replay_commit_allowed=false

raw_request_payload_storage_required=false
secret_material_storage_allowed=false
credential_storage_allowed=false
private_key_storage_allowed=false
master_key_storage_allowed=false

provider_dispatch_enabled=false
production_authorized=false
