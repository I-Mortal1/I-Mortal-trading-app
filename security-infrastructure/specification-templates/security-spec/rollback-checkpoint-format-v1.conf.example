commitment_storage_location_defined=false

counter_nv_handle_defined=false
counter_nv_attributes_defined=false
counter_nv_authorization_policy_defined=false

tpm_nv_counter_read_authorized=false
tpm_nv_increment_authorized=false
tpm_nv_allocation_authorized=false
tpm_nv_write_authorized=false
tpm_nv_undefine_authorized=false

rollback_authority_provisioning_authorized=false

