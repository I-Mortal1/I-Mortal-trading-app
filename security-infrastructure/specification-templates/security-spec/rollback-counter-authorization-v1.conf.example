contract=CONDOR-ROLLBACK-COUNTER-AUTHORIZATION-V1
parent_commitment_protocol_sha256=PUBLIC_DIGEST_REMOVED

default=DENY
fail_closed=true

purpose=DEFINE_AUTHORIZATION_AND_ATTRIBUTE_REQUIREMENTS_FOR_A_NEW_CONDOR_OWNED_TPM_NV_COUNTER

backend_family=COUNTER_PLUS_COMMITMENT
counter_type=TPM_NT_COUNTER

new_condor_nv_index_required=true
new_condor_nv_index_must_be_unique=true
new_condor_nv_index_must_not_overlap_existing_handles=true

existing_nv_reuse_allowed=false
existing_counter_reuse_allowed=false
existing_nv_ownership=FOREIGN_OR_UNKNOWN

known_existing_nv_handles=PUBLIC_DEPLOYMENT_VALUE_REMOVED

counter_security_authority=true
counter_checkpoint_epoch=true
counter_must_be_monotonic=true
counter_must_not_decrease=true
counter_reuse_forbidden=true

counter_value_must_not_be_authorized_from_process_memory=true
counter_value_must_not_be_authorized_from_database=true
counter_value_must_not_be_authorized_from_usb=true
counter_value_must_not_be_authorized_from_manifest=true

authorization_policy_required=true
authorization_policy_must_be_defined_before_provisioning=true
authorization_policy_must_bind_counter_to_condor_rollback_authority=true

authorization_policy_must_not_depend_on_drive_letter=true
authorization_policy_must_not_depend_on_disk_number=true
authorization_policy_must_not_depend_on_filesystem_size=true
authorization_policy_must_not_depend_on_usb_serial_alone=true

counter_readback_after_increment_required=true
counter_increment_requires_precommitted_checkpoint=true
counter_increment_must_not_be_first_phase=true
successful_increment_alone_does_not_finalize_checkpoint=true

database_commit_before_counter_increment=true
commitment_must_be_durable_before_counter_increment=true
commitment_must_match_after_counter_increment=true

startup_counter_reconciliation_required=true
startup_database_reconciliation_required=true
startup_commitment_reconciliation_required=true
startup_all_three_must_reconcile=true

counter_less_than_last_anchored_epoch=DENY
counter_equal_last_anchored_epoch=VERIFY_PREVIOUS_ANCHOR
counter_equal_prepared_next_epoch=VERIFY_PREPARED_COMMITMENT
counter_greater_than_prepared_next_epoch=DENY_OR_EXPLICIT_RECOVERY

unexpected_counter_advance=DENY
unexpected_counter_decrease=DENY
counter_read_failure=DENY

automatic_counter_reset=false
automatic_counter_repair=false
automatic_counter_reprovision=false

checkpoint_batching=REQUIRED
per_request_tpm_write=NOT_REQUIRED
maximum_unanchored_window=NOT_YET_DEFINED

counter_nv_attributes=NOT_YET_SELECTED
counter_nv_handle=NOT_YET_SELECTED
counter_nv_authorization_policy=NOT_YET_SELECTED

tpma_nv_orderly=NOT_SELECTED
orderly_counter_security_equivalence=NOT_PROVEN

hardware_monotonicity=REQUIRED

rollback_authority=TPM
commitment_authority=SQLITE_ON_VERACRYPT
cross_device_atomicity=NOT_CLAIMED

tpm_nv_public_read_authorized=false
tpm_nv_data_read_authorized=false
tpm_nv_increment_authorized=false
tpm_nv_allocation_authorized=false
tpm_nv_write_authorized=false
tpm_nv_undefine_authorized=false

tpm_key_creation_authorized=false
rollback_authority_provisioning_authorized=false

sqlite_installation_authorized=false
database_creation_authorized=false
schema_creation_authorized=false

provider_dispatch_enabled=false
hardware_operation_enabled=false
production_authorized=false