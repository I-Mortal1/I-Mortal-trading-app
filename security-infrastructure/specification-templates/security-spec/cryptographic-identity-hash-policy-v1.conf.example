contract=CONDOR-CRYPTOGRAPHIC-IDENTITY-HASH-POLICY-V1
parent_f11_sha256=PUBLIC_DIGEST_REMOVED
parent_f12_sha256=PUBLIC_DIGEST_REMOVED
parent_f13_sha256=PUBLIC_DIGEST_REMOVED

default=DENY
fail_closed=true

purpose=FREEZE_SYSTEM_WIDE_CRYPTOGRAPHIC_HASH_FINGERPRINT_ID_COMMITMENT_ENCRYPTION_AND_SIGNATURE_RULES

analysis_mode=READ_ONLY
provisioning_mode=NOT_AUTHORIZED

canonical_hash=SHA256
canonical_hash_output_bits=256
canonical_hash_output_bytes=32
canonical_hash_encoding=LOWERCASE_HEX_WHEN_TEXTUAL
canonical_hash_full_length_required=true
hash_truncation_for_security_commitments=false

canonicalization_required=true
canonical_text_encoding=UTF8_NO_BOM
canonical_text_line_endings=LF
canonical_binary_encoding=EXPLICIT_PROTOCOL_ENCODING
ambiguous_serialization_forbidden=true

domain_separation_required=true
domain_separator_required_for_security_identities=true
domain_separator_required_for_commitments=true
domain_separator_required_for_manifest_hashes=true
domain_separator_required_for_checkpoint_hashes=true
domain_separator_required_for_replay_commitments=true
domain_separator_required_for_key_identifiers=true
domain_separator_required_for_storage_identifiers=true

hash_input_context_must_be_explicit=true
raw_string_concatenation_without_canonical_encoding_forbidden=true

md5_forbidden=true
sha1_forbidden=true
sha256_canonical=true

cryptographic_hash_is_not_encryption=true
cryptographic_hash_is_not_key_derivation=true
cryptographic_hash_is_not_secret_storage=true

deterministic_security_ids_may_be_sha256_derived=true
security_id_generation_requires_domain_separation=true
security_id_generation_requires_canonical_input=true
security_id_generation_requires_algorithm_version_binding=true

storage_id_hash_family=SHA256
storage_id_derivation=SHA256_DOMAIN_SEPARATED_CANONICAL_IDENTITY
storage_id_stability_required=true
storage_id_must_not_depend_on_mutable_metadata=true
storage_id_must_not_depend_on_transient_hardware_identifiers=true
hardware_identifiers_are_supporting_evidence_only=true

key_id_hash_family=SHA256
key_fingerprint_hash_family=SHA256
public_key_fingerprint_input=CANONICAL_SPKI_DER
public_key_fingerprint_output=SHA256
public_key_fingerprint_full_length_required=true
private_key_material_must_not_be_exposed_for_fingerprinting=true

manifest_hash_family=SHA256
checkpoint_hash_family=SHA256
replay_commitment_hash_family=SHA256
contract_hash_family=SHA256
source_integrity_hash_family=SHA256
audit_record_hash_family=SHA256

commitment_algorithm=SHA256
commitment_length=32_BYTES
commitment_canonicalization=strict
commitment_domain_separation=required
commitment_algorithm_version_binding=required

encryption_algorithm=AES_256_GCM
encryption_key_size=256_BITS
encryption_nonce_requirement=UNIQUE_PER_ENCRYPTION
encryption_authenticated_data=SUPPORTED
encryption_integrity=AUTHENTICATED
sha256_must_not_be_used_as_encryption=true

signature_algorithm=ECDSA_P256_SHA256
signature_encoding=DER
signature_hash=SHA256
signature_public_key_representation=SPKI_DER
signature_fingerprint=SHA256

private_key_generation_requires_authorized_secure_boundary=true
private_key_storage_requires_hardware_or_authorized_secure_key_store=true
private_key_export_forbidden_by_default=true
private_key_plaintext_logging_forbidden=true
private_key_plaintext_telemetry_forbidden=true

tpm_private_key_protection=REQUIRED_WHEN_TPM_KEY_IS_SELECTED
hsm_private_key_protection=REQUIRED_WHEN_HSM_IS_SELECTED
software_private_key_storage_for_production=FORBIDDEN

key_identifier_must_not_be_secret=true
key_identifier_must_not_be_used_as_key_material=true
hash_output_must_not_be_reinterpreted_as_encryption_key_without_explicit_kdf=true

key_rotation_required=true
key_rotation_requires_new_key_identifier=true
key_rotation_requires_new_public_key_fingerprint=true
key_rotation_requires_explicit_algorithm_version=true
old_key_identifiers_must_remain_auditable=true
silent_key_replacement_forbidden=true

algorithm_agility_required=true
algorithm_identifier_required_in_security_objects=true
algorithm_version_required_in_security_objects=true
cryptographic_parameter_binding_required=true

security_object_hash_must_bind_algorithm=true
security_object_hash_must_bind_version=true
security_object_hash_must_bind_domain=true
security_object_hash_must_bind_canonical_representation=true

ai_access_to_private_keys=DENIED
ai_access_to_raw_secrets=DENIED
ai_access_to_private_key_material=DENIED
ai_access_to_secret_plaintext=DENIED

ai_may_receive_public_key_fingerprints=true
ai_may_receive_sha256_integrity_values=true
ai_may_not_modify_cryptographic_policy=true

hash_verification_failure=DENY
canonicalization_failure=DENY
algorithm_mismatch=DENY
version_mismatch=DENY
domain_mismatch=DENY
fingerprint_mismatch=DENY
