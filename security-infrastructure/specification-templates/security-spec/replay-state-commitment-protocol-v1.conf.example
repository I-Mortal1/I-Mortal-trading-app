contract=CONDOR-REPLAY-STATE-COMMITMENT-PROTOCOL-V1
parent_counter_persistence_sha256=PUBLIC_DIGEST_REMOVED
parent_checkpoint_format_sha256=PUBLIC_DIGEST_REMOVED
parent_orderly_observation_sha256=PUBLIC_DIGEST_REMOVED

default=DENY
fail_closed=true

purpose=DEFINE_CANONICAL_REPLAY_STATE_COMMITMENT_BEFORE_PRODUCTION_PROVISIONING

commitment_algorithm=SHA256
commitment_required=true
commitment_is_security_authority=true

canonicalization_required=true
canonicalization_must_be_deterministic=true
canonicalization_must_be_cross_process_stable=true
canonicalization_must_be_platform_independent=true

encoding=UTF8_NO_BOM_LF
binary_integer_encoding=BIG_ENDIAN
numeric_representation=CANONICAL
field_order=FIXED
field_names=FIXED
unknown_fields=DENY

domain_separation_required=true
domain_separator=CONDOR-REPLAY-STATE-V1

raw_database_file_hash_is_commitment=false
filesystem_metadata_is_commitment=false
file_order_is_commitment=false
sqlite_page_layout_is_commitment=false
sqlite_wal_layout_is_commitment=false
process_memory_is_commitment=false
usb_identity_is_commitment=false
veracrypt_volume_identity_is_commitment=false

commitment_input=CANONICAL_LOGICAL_REPLAY_STATE

request_identifier_included=true
nonce_included=true
replay_decision_state_included=true
consumption_state_included=true
checkpoint_epoch_included=true
checkpoint_sequence_included=true

raw_request_payload_included=false
secret_material_included=false
credentials_included=false
private_keys_included=false
telemetry_secrets_included=false

commitment_length=32_BYTES

checkpoint_commitment_required=true
checkpoint_commitment_must_be_stored_durably=true
checkpoint_commitment_must_be_bound_to_epoch=true
checkpoint_commitment_must_be_bound_to_sequence=true

prepared_commitment_must_be_durable=true
db_commitment_must_match_prepared_commitment=true
anchored_commitment_must_match_db_commitment=true

counter_epoch_must_match_checkpoint_epoch=true
counter_sequence_relationship_must_match_f7=true

counter_increment_before_commitment_durable=false
counter_increment_before_database_commit=false
counter_increment_before_prepared_checkpoint=false

database_commit_before_counter_increment=true
counter_increment_requires_precommitted_checkpoint=true
counter_readback_required_after_increment=true
counter_readback_mismatch=DENY
commitment_mismatch=DENY
database_mismatch=DENY
epoch_mismatch=DENY
sequence_mismatch=DENY

startup_database_commitment_required=true
startup_anchor_commitment_required=true
startup_tpm_epoch_required=true

startup_all_three_must_reconcile=true
startup_commitment_match_without_epoch_match_allows_operation=false
startup_epoch_match_without_commitment_match_allows_operation=false
startup_database_match_without_anchor_match_allows_operation=false

prepared_state=NON_AUTHORITY
db_committed_state=NON_AUTHORITY
tpm_advanced_state=NON_AUTHORITY
anchored_state=AUTHORITY

provider_dispatch_only_from_anchored_state=true
provider_dispatch_from_commitment_only=false
provider_dispatch_from_database_only=false
provider_dispatch_from_tpm_epoch_only=false

crash_before_commitment_persist=RECOVERABLE_NO_ANCHOR
crash_after_commitment_persist_before_db_commit=RECOVERABLE_NO_ANCHOR
crash_after_db_commit_before_counter_increment=RECOVERY_REQUIRED
crash_after_counter_increment_before_readback=RECOVERY_REQUIRED
crash_after_readback_before_anchor=RECOVERY_REQUIRED
crash_after_anchor=VERIFY_ON_RESTART

rollback_to_older_commitment=DENY
rollback_to_older_database=DENY
rollback_to_older_epoch=DENY
unrecognized_commitment=DENY
missing_commitment=DENY
corrupt_commitment=DENY

automatic_commitment_repair=false
automatic_epoch_repair=false
automatic_database_repair=false
automatic_anchor_repair=false

checkpoint_batching=ALLOWED
checkpoint_frequency_policy=REQUIRED_BEFORE_PRODUCTION
maximum_unanchored_window=REQUIRED_BEFORE_PRODUCTION

commitment_backend=SQLITE_ON_VERACRYPT
commitment_backend_authority=true
veracrypt_storage_required=true
bitlocker_dependency=false

sqlite_installation_authorized=false
database_creation_authorized=false
schema_creation_authorized=false

tpm_nv_allocation_authorized=false
tpm_nv_increment_authorized=false
tpm_nv_read_authorized=false
tpm_nv_write_authorized=false
tpm_key_creation_authorized=false

manifest_creation_authorized=false
provider_dispatch_enabled=false
hardware_operation_enabled=false
production_authorized=false
